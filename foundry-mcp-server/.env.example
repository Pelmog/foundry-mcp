# Foundry VTT connection config (the loader does not strip inline comments, so keep them on their own lines)
FOUNDRY_HOST=localhost
FOUNDRY_PORT=30000
# Login user. FOUNDRY_USER_NAME is stable across worlds; FOUNDRY_USER_ID is not.
# If FOUNDRY_USER_ID isn't a user of the active world, the id is resolved from the name via /join.
# Name of the GM user, e.g. Friend Computer
FOUNDRY_USER_NAME=
# GM user ID (find with: game.users.find(u => u.isGM)?.id)
FOUNDRY_USER_ID=
# GM password (empty if none set)
FOUNDRY_PASSWORD=
# Headless GM worker IPC socket (default shown)
# FOUNDRY_GM_SOCKET=/run/foundry-gm/gm.sock
